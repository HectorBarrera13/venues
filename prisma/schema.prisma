generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model VenueOwner {
  id     String  @id @map("_id")
  name   String
  venues Venue[]

  @@map("venue_owners")
}

model Venue {
  id          String     @id @default(uuid()) @map("_id")
  name        String
  description String     @map("desc")
  location    String
  ownerId     String
  owner       VenueOwner @relation(fields: [ownerId], references: [id])
  zones       Zone[]
  createdAt   DateTime   @default(now())

  @@index([ownerId])
  @@map("venues")
}

model Zone {
  id      String @id @default(uuid()) @map("_id")
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])
  name    String
  seats   Seat[]

  @@unique([venueId, name])
  @@map("zones")
}

model Seat {
  id     String @id @default(uuid()) @map("_id")
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])
  number String

  @@unique([zoneId, number])
  @@map("seats")
}
