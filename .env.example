DATABASE_URL="mongodb://127.0.0.1:27017/venue_db?replicaSet=rs0&directConnection=true"

# Host port compose publishes the api on. Leave it unset for 3000, or set it when
# another application already owns 3000 on your machine.
# VENUES_API_PORT=3100

# Secret used to sign and verify partner access tokens (HS256).
# Generate one with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
