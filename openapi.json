    "/venues/{id}/map": {
      "post": {
        "operationId": "saveVenueMap",
        "summary": "Save a new seat map version",
        "description": "Stores the payload as version latestMapVersion + 1. Versions are immutable. Requires the VENUE_OWNER role and ownership of the venue. Format: docs/map-format.md. Contract stub: answers 501 until implemented.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Venue identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MapPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Map stored as a new version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapVersion"
                }
              }
            }
          },
          "400": {
            "description": "Malformed payload (types, ranges, ids, limits)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not VENUE_OWNER, or not the owner of this venue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Venue not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The map breaks one or more business rules",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapValidationErrors"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "Not implemented yet: the route is a contract stub",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getVenueMap",
        "summary": "Get a seat map version",
        "description": "Returns the latest version, or the one given in \"version\". Contract stub: answers 501 until implemented.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Venue identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "Map version to read; latest when omitted.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Map version",
