          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Process liveness. Does not reach any dependency.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Readiness check",
        "description": "Reports whether the venue store is reachable. Answers 503 while it is not.",
        "responses": {
          "200": {
            "description": "Dependencies are reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            }
          },
          "503": {
            "description": "Venue store is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Partner access token with \"sub\", \"role\" and \"exp\" claims."
      }
    },
    "schemas": {
      "GeoLocation": {
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "description": "WGS84 position. Stored as a GeoJSON Point ([lng, lat]).",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "example": 19.4245
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "example": -99.1951
          }
        }
      },
      "CreateVenue": {
        "type": "object",
        "required": [
          "name",
          "address",
          "city",
          "country",
          "location"
        ],
        "description": "Text fields are trimmed. Any other field, including ownerId, is ignored: the owner is the token subject.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Auditorio Nacional"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "nullable": true
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Paseo de la Reforma 50"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Ciudad de Mexico"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code (lower case is accepted on input).",
            "example": "MX"
          },
          "location": {
            "$ref": "#/components/schemas/GeoLocation"
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "nullable": true,
            "description": "Id of the venue in externalSource. Requires externalSource."
          },
          "externalSource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "nullable": true,
            "example": "nominatim"
          },
          "osmRef": {
            "type": "string",
            "nullable": true,
            "pattern": "^(node|way|relation):[1-9]\\d*$",
            "description": "OpenStreetMap reference. Unique among venues when present.",
            "example": "way:123456"
          }
        }
      },
      "Venue": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "address",
          "city",
          "country",
          "location",
          "externalId",
          "externalSource",
          "osmRef",
          "latestMapVersion",
          "ownerId",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code (lower case is accepted on input).",
            "example": "MX"
          },
          "location": {
            "$ref": "#/components/schemas/GeoLocation"
          },
          "externalId": {
            "type": "string",
            "nullable": true
          },
          "externalSource": {
            "type": "string",
            "nullable": true
          },
          "osmRef": {
            "type": "string",
            "nullable": true,
            "pattern": "^(node|way|relation):[1-9]\\d*$",
            "description": "OpenStreetMap reference. Unique among venues when present.",
            "example": "way:123456"
          },
          "latestMapVersion": {
            "type": "integer",
            "minimum": 0,
            "description": "Highest stored map version; 0 while the venue has no map."
          },
          "ownerId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "VenuePage": {
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Venue"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "VenueConflict": {
        "type": "object",
        "required": [
          "error",
          "existingVenueId"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "existingVenueId": {
            "type": "string",
            "description": "Id of the venue already registered with that osmRef."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "ReadinessStatus": {
        "type": "object",
        "required": [
          "status",
          "venueStore"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "venueStore": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        }
      }
    }
  }
}
