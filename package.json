{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/src/server.js",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "openapi:generate": "node scripts/generate-openapi.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:test": "node --env-file=.env.test node_modules/prisma/build/index.js db push",
    "db:check": "tsx scripts/check-database.ts",
    "db:check:test": "node --env-file=.env.test --import tsx scripts/check-database.ts",
    "mongo:init": "tsx scripts/init-mongo.ts",
    "test": "jest",
    "start": "npm run build && node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "babel-jest": "^30.5.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jiti": "^2.7.0",
    "mongodb": "^6.21.0",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
