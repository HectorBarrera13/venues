{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*", "scripts/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "shared/mocks/verify.ts"]
}
